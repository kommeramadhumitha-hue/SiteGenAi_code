# =====================================================================
# SiteGen AI — Level 2 Backend Environment Configuration
# =====================================================================

# Server Network Settings
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------
# REAL AI PROVIDER INTEGRATION
# ---------------------------------------------------------------------
# Supported: gemini | openai | mock
# When GEMINI_API_KEY or OPENAI_API_KEY is populated, the server automatically
# enables Live LLM streaming and multimodal vision synthesis.
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
AI_API_KEY=

# Google Gemini (Get key at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# OpenAI (Get key at: https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Rate Limiting
RATE_LIMIT_MAX=60

# ---------------------------------------------------------------------
# MONGODB ATLAS DATABASE CONFIGURATION
# ---------------------------------------------------------------------
# Obtain connection string from MongoDB Atlas Console:
# 1. Sign up at https://www.mongodb.com/cloud/atlas
# 2. Create a free M0 cluster (e.g. "Cluster0")
# 3. Create a database user with readWrite privileges
# 4. Under Network Access, allow IP 0.0.0.0/0 (or your server IP)
# 5. Copy the standard connection string format:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/sitegen_ai?retryWrites=true&w=majority

# ---------------------------------------------------------------------
# GITHUB & EDGE DEPLOYMENT (LEVEL 3 PREPARATION)
# ---------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback
GITHUB_TOKEN=

# Hosting & Edge Deployment Webhooks (Vercel / Netlify / Cloudflare)
DEPLOYMENT_PROVIDER_TOKEN=
DEPLOYMENT_TEAM_ID=
VERCEL_TOKEN=
NETLIFY_AUTH_TOKEN=
